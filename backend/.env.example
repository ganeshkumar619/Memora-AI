# MEMORA AI - optional configuration.
# Copy this file to `.env` only if you want to change a setting.
# Every value below is optional; the app runs completely offline without them.

# --- Optional AI provider -----------------------------------------------------
# The deterministic Tamil / Tanglish / English command layer is always used
# first.  A provider is only consulted for open ended questions, and only when
# BOTH AI_PROVIDER and AI_API_KEY are set.  No key ships with this project.
# Never commit a real API key.
# AI_PROVIDER=openai-compatible
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- Optional database location ----------------------------------------------
# Defaults to `backend/memora.db`.  Set this to point at a different file
# (useful for tests or for keeping a personal database separate).
# MEMORA_DB_PATH=D:\MEMORA_AI\backend\memora.db
