# =============================================================================
# MEMORA AI - Backend Configuration (.env)
# =============================================================================
# Copy this file to `.env` in the `backend/` folder to configure your AI Brain:
#
#   copy .env.example .env
#
# MEMORA AI works offline in Local Fallback mode even without an API key.
# Adding a Google Gemini API key enables conversational NLU in Tamil, Tanglish,
# and English just like ChatGPT.
# =============================================================================

# --- Google Gemini AI Brain (Recommended) -----------------------------------
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_CLOUD_API_KEY=your_api_key_here
# Model to use for reasoning (defaults to gemini-2.5-flash with automatic fallback)
GEMINI_MODEL=gemini-2.5-flash

# --- Alternative AI Provider (Optional) -------------------------------------
# If you prefer OpenAI or an OpenAI-compatible endpoint instead:
# AI_PROVIDER=openai-compatible
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- SQLite Database Storage ------------------------------------------------
# Defaults to `backend/memora.db`. Custom path can be specified here:
# MEMORA_DB_PATH=D:\MEMORA_AI\backend\memora.db
